# Shikimori PHP SDK configuration
# Copy to your application root .env and adjust.

# Required: OAuth application name. Shikimori may ban requests without it.
SHIKIMORI_USER_AGENT=

SHIKIMORI_ENDPOINT=https://shikimori.io/api/graphql

# Optional Bearer token for user-specific queries (currentUser, userRates).
SHIKIMORI_ACCESS_TOKEN=

# Cache / persistence
SHIKIMORI_CACHE_TTL=86400
SHIKIMORI_CACHE_DIR=/tmp/shikimori_cache

# Rate limiting (requests per second / per minute)
SHIKIMORI_RATE_LIMIT_ENABLED=true
SHIKIMORI_RATE_LIMIT_RPS=5
SHIKIMORI_RATE_LIMIT_RPM=90

# OAuth2 credentials (only needed when using OAuth2Helper)
SHIKIMORI_OAUTH_CLIENT_ID=
SHIKIMORI_OAUTH_CLIENT_SECRET=
SHIKIMORI_OAUTH_REDIRECT_URI=
SHIKIMORI_OAUTH_AUTHORIZE_URL=https://shikimori.io/oauth/authorize
SHIKIMORI_OAUTH_TOKEN_URL=https://shikimori.io/oauth/token

# Cycle ORM database connection (only needed when using withOrm / withDatabase)
SHIKIMORI_DB_DRIVER=sqlite
SHIKIMORI_DB_HOST=localhost
SHIKIMORI_DB_PORT=
SHIKIMORI_DB_NAME=shikimori
SHIKIMORI_DB_USER=
SHIKIMORI_DB_PASSWORD=
SHIKIMORI_DB_SQLITE_PATH=/tmp/shikimori.sqlite
